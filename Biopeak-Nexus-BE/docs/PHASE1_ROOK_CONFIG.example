# Biopeak Phase 1: operator reference only. Do not commit actual secrets.
# Replace STG_ with DEV_ or PRD_ depending on settings module.
STG_WEARABLES_ENABLED=False
STG_WEARABLES_REQUIRE_PROFILE_FEATURE=True
STG_TIMELINE_ENABLED=False
STG_TIMELINE_INCLUDE_LEGACY_RESULTS=True
STG_ROOK_ENVIRONMENT=sandbox
STG_ROOK_BASE_URL=https://api.rook-connect.review
STG_ROOK_CLIENT_UUID=CHANGE_ME
STG_ROOK_SECRET_KEY=CHANGE_ME
STG_ROOK_WEBHOOK_HASH_KEY=CHANGE_ME
STG_ROOK_SDK_CLIENT_UUID=CHANGE_ME
STG_ROOK_SDK_SECRET=CHANGE_ME
# Optional callback: short HTTPS address ending in /r.
# ROOK appends 16-character nonce. Total redirect_url <= 50 characters.
# STG_ROOK_CALLBACK_URL=https://api.example.org/r
STG_ROOK_OAUTH_TIMEOUT_MINUTES=15
# Optional fallback redirect host allowlist (ROOK also limits redirects to 50 characters).
# STG_ROOK_MOBILE_REDIRECT_ALLOWED_HOSTS=example.org
STG_ROOK_HISTORICAL_DAYS=7
STG_ROOK_SYNC_DELAY_HOURS=48
STG_ROOK_CONNECT_TIMEOUT_SECONDS=5
STG_ROOK_READ_TIMEOUT_SECONDS=12
STG_ROOK_ALLOW_UNSIGNED_WEBHOOKS=False
# Also supported globally in base settings:
HEALTH_DASHBOARD_CACHE_SECONDS=60
HEALTH_MIN_BASELINE_DAYS=7
