SECRET_KEY=
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
OPENAI_API_KEY=
METSIGHTS_API_KEY=

# ASK-AI service-account key sent server-side as X-API-KEY
DEV_ASK_AI_API_KEY=
STG_ASK_AI_API_KEY=
PRD_ASK_AI_API_KEY=

DEV_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
DEV_GOOGLE_CLIENT_SECRET=your-client-secret
DEV_GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/google-calendar/callback/
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEV_GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Email of the fixed shared Associate account whose Google Calendar receives all appointment sync
DEV_GOOGLE_CALENDAR_ID=
# Where the OAuth callback redirects the browser back to after connecting/failing
DEV_ADMIN_FRONTEND_URL=http://localhost:5173

# === ROOK Wearables / Biopeak Phase 1 (never commit actual credentials) ===
# Choose the matching prefix for DJANGO_SETTINGS_MODULE.
# For local development (PROVISIONED_SOURCES is required, exact ROOK names):
DEV_WEARABLES_ENABLED=true
DEV_ROOK_ENVIRONMENT=sandbox
DEV_ROOK_BASE_URL=https://api.rook-connect.review
DEV_ROOK_CLIENT_UUID=
DEV_ROOK_SECRET_KEY=
DEV_ROOK_PROVISIONED_SOURCES=
DEV_ROOK_WEBHOOK_HASH_KEY=
# HTTPS public short URL ending with /r; full redirect plus nonce <= 50 chars.
DEV_ROOK_CALLBACK_URL=
# REQUIRED for ROOK API/OAuth authorizers: exact trusted HTTPS hostnames,
# comma-separated (no scheme, path, or wildcards). Empty list is denied.
# Garmin requires connect.garmin.com when you enable its OAuth connection.
# Set DEV_ROOK_AUTHORIZATION_ALLOWED_HOSTS=connect.garmin.com in your real .env.
# Reconnection requests a new authorizer URL after revoke, so this setting is
# required even if the first connect appeared to work with authorized=true.
# For other API providers, add only independently verified authorizer hosts.
DEV_ROOK_AUTHORIZATION_ALLOWED_HOSTS=
# Native SDK: use the SAME ROOK Client UUID as DEV_ROOK_CLIENT_UUID above.
# Secret must be the independent SDK Authentication Secret Word registered
# for the mobile app's bundle ID/package name in ROOK Portal. NEVER copy
# DEV_ROOK_SECRET_KEY (server API Basic-auth secret) into DEV_ROOK_SDK_SECRET.
DEV_ROOK_SDK_CLIENT_UUID=
DEV_ROOK_SDK_SECRET=
# Enable only after confirming that the SDK Secret Word is intended for
# mobile distribution. Treat it as extractable from a compromised device.
DEV_ROOK_SDK_CLIENT_CREDENTIALS_PUBLIC=false
DEV_ROOK_PREEXISTING_ENABLED=true
DEV_ROOK_HISTORICAL_DAYS=7
DEV_ROOK_PROVISIONED_SOURCES=
# For staging/production, set equivalent STG_/PRD_ keys in secret manager:
# STG_ROOK_CLIENT_UUID, STG_ROOK_SECRET_KEY, STG_ROOK_PROVISIONED_SOURCES,
# STG_ROOK_WEBHOOK_HASH_KEY, STG_ROOK_CALLBACK_URL, STG_WEARABLES_ENABLED
# PRD_ROOK_CLIENT_UUID, PRD_ROOK_SECRET_KEY, PRD_ROOK_PROVISIONED_SOURCES,
# PRD_ROOK_WEBHOOK_HASH_KEY, PRD_ROOK_CALLBACK_URL, PRD_WEARABLES_ENABLED
# STG_/PRD_ROOK_PREEXISTING_ENABLED default false (explicit ROOK entitlement required)
# ROOK webhook URLs (configure them in ROOK portal with the hash key):
#   https://<PUBLIC_DOMAIN>/webhooks/rook/data/
#   https://<PUBLIC_DOMAIN>/webhooks/rook/notification/

# Distributed Django ScopedRateThrottle counters across all ECS workers.
# Required when STG_WEARABLES_ENABLED or PRD_WEARABLES_ENABLED is true.
# Use a private ElastiCache endpoint; prefer TLS rediss:// (password/token
# supplied by Secrets Manager). Database 0 must be shared by every ECS task.
# Do not commit real credentials. Health snapshots continue to use DummyCache.
STG_REDIS_URL=
PRD_REDIS_URL=
