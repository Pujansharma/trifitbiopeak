SECRET_KEY=
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
OPENAI_API_KEY=
METSIGHTS_API_KEY=

# ASK-AI service-account key sent server-side as X-API-KEY
DEV_ASK_AI_API_KEY=
STG_ASK_AI_API_KEY=
PRD_ASK_AI_API_KEY=

DEV_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
DEV_GOOGLE_CLIENT_SECRET=your-client-secret
DEV_GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/google-calendar/callback/
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEV_GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Email of the fixed shared Associate account whose Google Calendar receives all appointment sync
DEV_GOOGLE_CALENDAR_ID=
# Where the OAuth callback redirects the browser back to after connecting/failing
DEV_ADMIN_FRONTEND_URL=http://localhost:5173

# === ROOK Wearables / Biopeak Phase 1 (never commit actual credentials) ===
# Choose the matching prefix for DJANGO_SETTINGS_MODULE.
# Mobile UI flag is configured separately in PostHog; this remains a backend
# safety switch for API routes, webhook ingress and background workers.
DEV_WEARABLES_ENABLED=true
# ROOK API URLs and all credentials remain environment-specific.
DEV_ROOK_BASE_URL=https://api.rook-connect.review
DEV_ROOK_CLIENT_UUID=
DEV_ROOK_SECRET_KEY=
DEV_ROOK_WEBHOOK_HASH_KEY=
# HTTPS public short URL ending with /r; full redirect plus nonce <= 50 chars.
DEV_ROOK_CALLBACK_URL=
DEV_ROOK_SDK_CLIENT_UUID=
DEV_ROOK_SDK_SECRET=
# Only if ROOK confirms this is a dedicated mobile-distributable key, not the Basic-auth key:
DEV_ROOK_SDK_CLIENT_CREDENTIALS_PUBLIC=false
# ROOK_ENVIRONMENT, ROOK_HISTORICAL_DAYS, ROOK_AUTHORIZATION_ALLOWED_HOSTS,
# ROOK_PROVISIONED_SOURCES and ROOK_PREEXISTING_ENABLED now come from
# core/settings/{development,staging,production}.py and rook_static.py.
# For staging/production, supply the equivalent STG_/PRD_ ROOK credentials,
# callback URLs and ROOK_BASE_URL through the normal secrets process.
# Keep STG_WEARABLES_ENABLED / PRD_WEARABLES_ENABLED as backend safety flags.
# Before enabling, confirm the hardcoded provider list/hosts and the
# historical-import entitlement against each ROOK account.
# ROOK webhook URLs (configure them in ROOK portal with the hash key):
#   https://<PUBLIC_DOMAIN>/webhooks/rook/data/
#   https://<PUBLIC_DOMAIN>/webhooks/rook/notification/

# Optional shared Django default cache for distributed DRF API throttling.
# ROOK endpoints already use ScopedRateThrottle without Redis; when unset,
# LocMemCache rate limits apply per worker rather than across ECS tasks.
# Use BioPeak's existing shared-cache infrastructure if global limits are needed.
# Do not commit real credentials. Health snapshots use DummyCache.
STG_REDIS_URL=
PRD_REDIS_URL=
