meta {
  name: POST Assign Test Kit
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/test_kit_inventory/assign
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "assigned_to": [
      "{{customer_profile_id}}"
    ],
    "handover_type": "delivery",
    "is_kit_journey_visible": true,
    "products": [
      "{{product_id}}"
    ]
  }
}

settings {
  encodeUrl: true
}
