meta {
  name: POST Book Appointment
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/
  body: json
  auth: inherit
}

headers {
  content-type: application/json
  Idempotency-Key: {{idempotency_key}}
}

body:json {
  {
    "start": "2026-09-09T04:00:00Z",
    "end": "2026-09-09T04:30:00Z",
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "room_id": "{{room_id}}",
    "equipment_id": "{{equipment_id}}",
    "doctor_id": "{{doctor_id}}",
    "specialty_id": "{{specialty_id}}",
    "care_team_id": "{{care_team_id}}",
    "notes": "First visit"
  }
}

script:pre-request {
  if (!bru.getEnvVar('idempotency_key')) {
    bru.setEnvVar('idempotency_key', bru.interpolate('{{$uuid}}'));
  }
  let body = req.getBody();
  if (typeof body === 'string') {
    body = JSON.parse(body);
  }
  body = body || {};
  const resourceKeys = ['doctor_id', 'specialty_id', 'care_team_id', 'room_id', 'equipment_id'];
  for (const key of resourceKeys) {
    if (!Object.prototype.hasOwnProperty.call(body, key)) {
      continue;
    }
    const value = String(body[key] || '').trim();
    if (value) {
      body[key] = value;
    } else {
      delete body[key];
    }
  }
  if (body.care_team_id) {
    delete body.doctor_id;
    delete body.specialty_id;
  }
  req.setBody(body);
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Books a confirmed appointment. Use Idempotency-Key for safe retries.
  Same key + same body → 200 existing appointment (slot is not re-checked).
  Same key + different body → 409.
  start in the past → 400 "Date cannot be in the past."
  Flattened body (no preferred nest, no associates[] pin). Echo Find Slots
  nested resource `id`s as top-level IDs plus slot start/end.
  Body lists every allowed key. Empty resource UUIDs stripped in pre-request.
  If care_team_id is set, pre-request drops doctor_id/specialty_id (XOR) so
  a filled env still sends. People path: blank care_team_id in env.
  Staff: care_team_id XOR doctor_id/specialty_id (doctor+specialty OK; not same person).
  specialty_id must hold a live non-doctor role mapped to this service (many hats OK).
  Service with 0 role reqs: omit specialty_id; doctor_id / care_team_id still OK.
  health_coach_id → 400 "Use specialty_id instead of health_coach_id."
  modality virtual | in_person (not both).
  end must equal start + center service duration.
  in_person: room_id required; room active, type active, type mapped to service (OR).
  virtual: no room_id / equipment_id.
  equipment_id required when the selected room has ≥1 bookable unit (active + type
  active + allotted to that room); omit/null when the room has none. Must belong
  to that room. No auto-pick of first equipment.
  Booked appointment always has non-empty associates[] (hats stamped server-side).
  Overlap → 400 "Slot no longer available."
  customer_profile_id / service_id must be active at this center.
  notes is optional free text, stored on the appointment as-is and also appended to a
  formatted Google event description (patient name, service, date, time, then either
  the clinic address for in_person/both or a "join via Google Meet" line for virtual —
  no address shown for virtual).
  Google Calendar: if the one fixed shared account (GOOGLE_CALENDAR_ID, see
  google_calendar/Connect + Complete) is connected, a Google Calendar outbox
  row is queued after commit (not on the request path). The worker mirrors
  the appointment later, with assigned associates invited as attendees.
  Best-effort — booking always succeeds even if this sync fails or nobody is
  connected; a Google failure is logged, never surfaced as an error.
  Book response google_meet_link is usually null until the worker finishes;
  refetch appointment detail after sync.
}
