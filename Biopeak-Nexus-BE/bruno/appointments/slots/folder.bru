meta {
  name: slots
  type: folder
}

auth {
  mode: inherit
}

docs {
  POST /centers/{{center_id}}/appointments/slots/
  preferred keys: room_id, equipment_id, care_team_id, doctor_id, specialty_id.
  care_team_id XOR doctor_id/specialty_id. in_person needs room_id.
  equipment_id required when that room has ≥1 bookable unit.
  Slot response: nested care_team/doctor/specialty/room/equipment; omit absent.
}
