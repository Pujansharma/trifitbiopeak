meta {
  name: GET List Appointments
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/appointments/?start=2026-09-01&granularity=week
  body: none
  auth: inherit
}

params:query {
  start: 2026-09-01
  granularity: week
  ~search: Meera
  ~associate_id: {{associate_id}}
  ~role_id: {{role_id}}
  ~service_id: {{service_id}}
  ~room_id: {{room_id}}
  ~equipment_id: {{equipment_id}}
  ~equipment_type_id: {{equipment_type_id}}
  ~status: confirmed
  ~care_team_id: {{care_team_id}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Calendar list for center. Staff only (admin/associate). Customers use
  GET /appointments/customer-appointments/<customer_profile_id>/.
  Week/month + unscoped search hard-cap 500 (LIMIT 501, no full COUNT); truncated + total_count (= page size).
  Optional AND filters: service_id, room_id, equipment_id, equipment_type_id, status, care_team_id.
  associate_id + role_id together = OR (any matching associate-link). Enable ~params only when set; blank UUID → 400.
  associate_id / role_id match appointment associates[] (always present on booked rows).
  search: customer name/email/phone, appointment code, service name. Omit start for all-history
  matches (newest first, also capped 500). search + start = windowed. Never send empty search=.
  List items include nested center {id, code, name}.
}
