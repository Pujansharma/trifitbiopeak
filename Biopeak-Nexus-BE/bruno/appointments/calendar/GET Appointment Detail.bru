meta {
  name: GET Appointment Detail
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/centers/{{center_id}}/appointments/{{appointment_id}}/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Full appointment detail including exclusive bounds and buffers.
  notes: free-text notes set at booking/reschedule time, or null.
  google_meet_link: the mirrored Google Calendar event's Meet link, or null/blank if
  the appointment isn't synced (no connected associate, or not virtual modality).
}
