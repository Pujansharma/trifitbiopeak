meta {
  name: appointments
  type: folder
}

auth {
  mode: inherit
}

docs {
  Center-scoped appointment booking under /centers/{{center_id}}/appointments/.
  Care teams catalog: /centers/{{center_id}}/care-teams/.
  Staff-only (associate/admin). No X-Center-ID required.
  Env: center_id, customer_profile_id, service_id, appointment_id, care_team_id, doctor_id, specialty_id, room_id, equipment_id, slot_date, idempotency_key.
  Find Slots: preferred nest. Book/reschedule: same IDs flattened at top level (no associates[] pin).
}
