meta {
  name: POST Create Care Team
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/care-teams/
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Alpha",
    "members": [
      {
        "associate_id": "{{associate_id}}",
        "role_id": "{{role_id}}"
      },
      {
        "associate_id": "{{associate_id_2}}",
        "role_id": "{{role_id_2}}"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Create a named care team. members required, min 2. Unique role and associate on the team.
  Name unique per center, case-insensitive ("Health" clashes with "health").
  Associates must have an active center assignment with that role. Role must be active (inactive role → 400 "Role is inactive.").
  Auth: bearer {{access_token}}. Set env center_id, associate_id, role_id, associate_id_2, role_id_2.
}
