meta {
  name: GET Browser State Callback
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/r/{{rook_state_token}}/client_uuid/{{rook_client_uuid}}/user_id/{{rook_user_id}}/
  body: none
  auth: none
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Public, one-time ROOK callback. Uses only genuine state/client/member identifiers. A valid return normally queues server verification and responds 202. It does not call ROOK or grant authorization in this HTTP request. Authorization becomes confirmed only after the regular worker verifies it.
}
