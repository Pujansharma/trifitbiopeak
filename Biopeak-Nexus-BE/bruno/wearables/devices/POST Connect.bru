meta {
  name: POST Connect
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/api/v1/devices/connect/
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "data_source": "{{rook_data_source}}",
    "consent_accepted": true,
    "consent_version": "v1",
    "historical_days": 7
  }
}

settings {
  encodeUrl: true
}

docs {
  Starts interactive provider authorization. The returned URL is still opened by the member. Backend verification is queued; successful verification queues the initial seven-day API history window. Do not treat a callback redirect as proof of authorization. Native sources still require the mobile SDK.
}
