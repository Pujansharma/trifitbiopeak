meta {
  name: POST Revoke Consent
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/api/v1/devices/consent/revoke/
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {}
}

settings {
  encodeUrl: true
}

docs {
  Revokes ingestion consent immediately for all wearable sources and queues pending API-provider revocations. History is retained under the existing policy. Delayed provider callbacks cannot re-enable ingestion.
}
