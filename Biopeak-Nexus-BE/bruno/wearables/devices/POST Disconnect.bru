meta {
  name: POST Disconnect
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/api/v1/devices/disconnect/
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "data_source": "{{rook_data_source}}"
  }
}

settings {
  encodeUrl: true
}

docs {
  Revokes this provider locally immediately; HTTP 200 does not claim remote completion. upstreamRevokePending remains true while the queued worker calls ROOK and verifies the provider grant is absent. Repeated requests coalesce; an explicit repeat can retry failed remote revocation. Existing history is retained.
}
