meta {
  name: GET Providers
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/api/v1/devices/providers/
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Combined catalogue: each API provider with its connection state, nativeStatuses, connections and ROOK identity. This is the replacement for GET /api/v1/devices/. Does not force upstream refresh.
}
