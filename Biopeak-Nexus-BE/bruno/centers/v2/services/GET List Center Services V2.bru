meta {
  name: GET List Center Services V2
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/v2/services/?page=1&limit=10
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
  ~search:
  ~active:
  ~min_duration_met:
  ~resource_active:
}

headers {
  X-Center-ID: {{center_id}}
}

script:pre-request {
  const token =
    bru.getEnvVar('access_token') ||
    bru.getCollectionVar('access_token') ||
    bru.getVar('access_token') ||
    '';
  if (!token) {
    throw new Error('access_token missing — run Auth → Login Phone Direct (Development env)');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Assigned services + nested assignment config (duration, buffers, modality, required room types/roles).
  assignment.required_room_type_ids / required_room_types / required_role_ids / required_roles — arrays (may be empty). No equipment type on assignment.
  Query: optional active=0|1 (omit = active + inactive).
  min_duration_met=0|1 (1 = assignment duration >= 30; 0 = duration null or < 30; omit = no duration filter).
  resource_active=0|1. Independent AND with min_duration_met. Omit / junk = no that filter.
  resource_active=1: virtual = >=1 live assigned role; both/in_person = live role AND >=1 live required room type.
  resource_active=0 = inverse. Role live = requirement is_active and AssociateRole.is_active.
  Room live = room_type_requirements set and RoomType.is_active. Separate from service active=.
  v1 GET /centers/{{center_id}}/services/ unchanged.
  Auth: pre-request sets Authorization from env/collection access_token (auth none — avoids empty Bearer). Run Login Phone Direct first.
}
