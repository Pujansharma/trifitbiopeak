meta {
  name: POST Create Room
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/v2/rooms/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Consultation Room 1",
    "room_type_id": "{{room_type_id}}",
    "capacity": 1,
    "floor": "1",
    "equipment_ids": []
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Create room. Set env room_type_id first.
  Optional: capacity (min 1), floor, equipment_ids (paste UUID strings into the array; empty = none).
  Do not use Bruno vars inside JSON arrays.
  Do not send code; server generates RM-{center_code}-{seq} (e.g. RM-CT-0001-0001).
  room_type_id and equipment_ids must be active for this center; inactive → 400.
  Name unique per center, case-insensitive. Duplicate → 400 name: "A room with this name already exists."
}

example {
  name: 400 Duplicate name

  request: {
    url: {{baseURL}}/centers/{{center_id}}/v2/rooms/
    method: POST
    mode: json
    headers: {
      X-Center-ID: {{center_id}}
      Content-Type: application/json
    }

    body:json: {
      {
        "name": "Consultation Room 1",
        "room_type_id": "{{room_type_id}}",
        "capacity": 1,
        "floor": "1",
        "equipment_ids": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "detail": {
            "name": [
              "A room with this name already exists."
            ]
          }
        }
      '''
    }
  }
}
