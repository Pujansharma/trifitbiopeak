meta {
  name: PATCH Room
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/v2/rooms/{{room_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Consultation Room 1",
    "capacity": 1,
    "is_active": true
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Update room. Set env room_id. capacity min 1. is_active false to deactivate.
  Optional: equipment_ids UUID list for full replace; empty list clears mappings.
  Optional room_type_id / equipment_ids must be active for this center; inactive → 400.
  Name unique per center, case-insensitive. Same row may keep its name. Duplicate → 400 name: "A room with this name already exists."
}
