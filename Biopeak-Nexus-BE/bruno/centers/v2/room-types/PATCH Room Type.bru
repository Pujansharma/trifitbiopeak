meta {
  name: PATCH Room Type
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/v2/room-types/{{room_type_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Consultation",
    "is_active": true
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Update room type. Deactivate with is_active=false (no DELETE).
}
