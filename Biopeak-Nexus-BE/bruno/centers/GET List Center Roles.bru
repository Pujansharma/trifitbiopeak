meta {
  name: GET List Center Roles
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/centers/{{center_id}}/associate-roles/?page=1&limit=10&active=1&search=
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  active: 1
  search: 
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Center-scoped associate roles (admin or associate JWT). Set env center_id.

  Query: page, limit, search (name), active=0|1.

  Fields: id, name, role_tag, is_system, created_by, is_active, created_at, updated_at.

  Auth: bearer {{access_token}}. Run Auth -> Login Phone Direct first.
}
