meta {
  name: GET Latest Consent History
  type: http
  seq: 5
}

get {
  url: {{baseURL}}/compliance/consent-journey/latest-consent-history/{{customer_profile_id}}/
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  GET /compliance/consent-journey/latest-consent-history/<uuid:customer_profile_id>/

  Customer JWT only. Profile must belong to authenticated customer.

  Newest ConsentForm version V → latest distinct consent_name rows for V.
  data = object keyed by consent_name (omit if missing):
  {
    personalised_health_services: { consent_form_version, value },
    ...
  }

  404 if no history for the newest ConsentForm.
}
