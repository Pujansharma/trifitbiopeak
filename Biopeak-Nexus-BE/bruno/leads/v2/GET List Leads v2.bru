meta {
  name: GET List Leads v2
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/leads/v2
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "is_onboarding_sent": true
  }
}

settings {
  encodeUrl: true
}

docs {
  `customer_profile.address` matches GET /leads/v2/{id}/: default address, else newest. Null when the lead has no profile or no address. No latitude or longitude.
}
