meta {
  name: POST Revoke Wearable Consent
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/devices/revoke-consent/
  body: json
  auth: inherit
}

headers {
  X-Customer-Profile-ID: {{customer_profile_id}}
  X-Correlation-ID: {{$uuid}}
  Content-Type: application/json
}

body:json {
  {}
}

docs {
  Withdraws wearable consent for the selected owned customer profile.
  New ROOK ingestion is blocked locally. API connections queue upstream revoke
  jobs; canonical history is retained pending the approved retention policy.
  Requires member JWT and an owned X-Customer-Profile-ID.
}
