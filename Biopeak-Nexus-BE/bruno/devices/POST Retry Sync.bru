meta {
  name: POST Retry Sync
  type: http
  seq: 6
}

post {
  url: {{baseURL}}/devices/retry-sync/
  body: json
  auth: inherit
}

headers {
  X-Customer-Profile-ID: {{customer_profile_id}}
  X-Correlation-ID: {{$uuid}}
  Content-Type: application/json
}

body:json {
  {
    "data_source": "Garmin"
  }
}

docs {
  Queues a fresh backend-side ROOK recovery attempt for an API source.
  Native SDK sources must synchronize on-device. Requires member JWT.
}
