meta {
  name: GET Current Versions
  type: http
  seq: 10
}

get {
  url: {{baseURL}}/supplementation/profiles/{{customer_profile_id}}/protocols/current-versions/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  Staff copy picker. Admin + associate. No X-Center-ID.
  Active profile or 404. Not paginated. Inactive protocols included.
  One row per protocol: highest version_number in approved, scheduled, active,
  expired, or cancelled. Superseded is the row only when every higher version
  is draft or under_review. Draft and under_review are never the row.
  A protocol with no such version is omitted. Approved is listed before publish,
  so Protocol.current_version may be null. Newest protocol created_at first.
  data[]: id (protocol), name (protocol name), current_version_id (the chosen version),
  version_name (v1, v2, …), supplement_count (ProtocolItem count on that version),
  effective_from (starts_on), stored status.
  Env: customer_profile_id from GET Profiles customer_profile.id.
}
