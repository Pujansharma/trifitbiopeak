meta {
  name: GET Profile Events
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/supplementation/profiles/{{customer_profile_id}}/events/?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  ~action:
}

settings {
  encodeUrl: true
}

docs {
  Staff recent activity for one profile. Admin + associate. No X-Center-ID.
  Active profile or 404. Unknown id → 404.
  page, limit (default 10, max 50). Newest created_at first.
  action: optional stored action code. Junk → 400 "Invalid action."
  Includes client_visible false.
  data[]: id, action, reason, client_visible, client_title, change_type, effective_on,
  protocol_id, protocol_version_id, before, after, created_at.
  Env: customer_profile_id from GET Profiles customer_profile.id.
}
