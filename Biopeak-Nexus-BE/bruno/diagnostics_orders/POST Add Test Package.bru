meta {
  name: POST Add Test Package
  type: http
  seq: 10
}

post {
  url: {{baseURL}}/diagnostics_orders/add-test-package/
  body: json
  auth: inherit
}

headers {
  @description('Optional')
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

body:json {
  {
    "test_id": {{diagnostics_test_id}},
    "name": "CBC",
    "price": "499.00"
  }
}

settings {
  encodeUrl: true
}

docs {
  Create-only catalog item. Body: test_id (int ≥1), name, price (≥0). Duplicate test_id → 400. National catalog (no city_prices).
}

example {
  name: 201 Created
  
  request: {
    url: {{baseURL}}/diagnostics_orders/add-test-package/
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      X-Center-ID: {{center_id}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "test_id": {{diagnostics_test_id}},
        "name": "CBC",
        "price": "499.00"
      }
    }
  }
  
  response: {
    headers: {
      Authorization: Bearer {{access_token}}
      X-Center-ID: {{center_id}}
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "detail": "Catalog item created.",
          "data": {
            "id": "01900000-0000-7000-8000-0000000000aa",
            "test_id": 12345,
            "name": "CBC",
            "price": "499.00"
          }
        }
      '''
    }
  }
}

example {
  name: 400 Duplicate test_id
  
  request: {
    url: {{baseURL}}/diagnostics_orders/add-test-package/
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      X-Center-ID: {{center_id}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "test_id": {{diagnostics_test_id}},
        "name": "CBC",
        "price": "499.00"
      }
    }
  }
  
  response: {
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "detail": "Validation error",
          "errors": {
            "test_id": [
              "Catalog item with this test_id already exists"
            ]
          }
        }
      '''
    }
  }
}
