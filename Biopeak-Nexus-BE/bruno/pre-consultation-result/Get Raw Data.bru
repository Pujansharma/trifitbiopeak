meta {
  name: Get Raw Data
  type: http
  seq: 12
}

get {
  url: {{baseURL}}/pre-consultation/result/{{customer_user_id}}/raw-data/
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  GET /pre-consultation/result/<user_id>/raw-data/
  
  Flattened layer answers for audit/export.
  patient_baseline includes height (cm) and weight (kg) from CustomerProfile (null until set).
  
  Reference: docs/pre_consultation/api-pre-consultation-result.md
}
