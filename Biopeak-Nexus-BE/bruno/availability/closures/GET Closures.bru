meta {
  name: GET Closures
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/centers/{{center_id}}/availability/closures/?active=1
  body: none
  auth: inherit
}

params:query {
  active: 1
  ~start: 2026-08-01
  ~end: 2026-08-31
}

headers {
  X-Center-ID: {{center_id}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  List center closures (holidays / manual closed days). Optional active=0|1, start/end as YYYY-MM-DD inclusive date range. Ordered by date descending.
}
