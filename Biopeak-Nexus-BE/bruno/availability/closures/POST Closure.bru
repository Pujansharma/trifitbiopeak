meta {
  name: POST Closure
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/closures/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "date": "2026-09-07",
    "type": "holiday",
    "reason": "Sample center holiday"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Close a date. type: holiday | manual. reason always required (name the holiday or why closed).
  Rejects duplicate active (center, date). Inactive same date reactivated with new type/reason.
  Sample date in GET Center Availability week of 2026-09-01.
  Set closure_id from response data.id for PATCH.
}
