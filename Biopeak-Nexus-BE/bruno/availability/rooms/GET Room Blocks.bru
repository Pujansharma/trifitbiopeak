meta {
  name: GET Room Blocks
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/centers/{{center_id}}/availability/room-blocks/{{room_id}}/?active=1
  body: none
  auth: inherit
}

params:query {
  active: 1
}

headers {
  X-Center-ID: {{center_id}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  List room blocks. Paginated. active=0|1 (omit → active only).
  Recurring POST expands to one row per weekday — same times / effective_from / reason.
  To deactivate a whole series, PATCH is_active=false on every sibling id from this list.
}
