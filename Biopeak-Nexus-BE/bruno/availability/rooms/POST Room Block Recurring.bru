meta {
  name: POST Room Block Recurring
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/room-blocks/{{room_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "is_recurring": true,
    "days_of_week": ["0", "2", "4"],
    "recurring_start_time": "11:00:00",
    "recurring_end_time": "13:00:00",
    "effective_from": "2026-09-01",
    "reason": "Weekly hold"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Recurring room block. Room from URL. days_of_week ("0"=Mon … "6"=Sun) → one row per day.
  POST 201 {detail, data}. data = array of created rows (one per day). Set room_block_id from data[n].id for PATCH.
  No effective_until — open-ended until PATCH is_active=false. Rejects overlap.
}
