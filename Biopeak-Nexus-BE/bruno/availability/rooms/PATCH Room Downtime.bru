meta {
  name: PATCH Room Downtime
  type: http
  seq: 6
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/availability/room-downtimes/{{room_id}}/{{room_downtime_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "is_active": false
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Soft-deactivate room downtime. Room from URL. Set room_downtime_id from POST response.
}
