meta {
  name: POST Room Block One-off
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/room-blocks/{{room_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "is_recurring": false,
    "date": "2026-09-02",
    "start_time": "14:00:00",
    "end_time": "16:00:00",
    "reason": "Reserved for training"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  One-off room block. Room from URL. Same-day only: date + start_time + end_time. No days_of_week.
  POST 201 {detail, data}. data = array of created rows. Set room_block_id from data[0].id for PATCH.
  Rejects overlap.
}
