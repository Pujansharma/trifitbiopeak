meta {
  name: POST Associate Leave
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/associates/{{associate_id}}/leaves/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "scope": "center",
    "start_datetime": "2026-09-05T00:00:00+05:30",
    "end_datetime": "2026-09-05T23:59:59+05:30",
    "reason": "Personal leave"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Associate leave. Associate from URL. scope=center uses URL center; scope=all_centers stores center=null.
  Set associate_leave_id from response for PATCH.
}
