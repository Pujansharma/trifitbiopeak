meta {
  name: PATCH Associate Leave
  type: http
  seq: 9
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/availability/associates/{{associate_id}}/leaves/{{associate_leave_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "is_active": false
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Soft-deactivate associate leave. Set associate_leave_id from POST response.
}
