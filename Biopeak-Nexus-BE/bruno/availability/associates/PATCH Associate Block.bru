meta {
  name: PATCH Associate Block
  type: http
  seq: 7
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/availability/associates/{{associate_id}}/blocks/{{associate_block_id}}/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "is_active": false
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Soft-deactivate associate block (is_active=false). No effective_until — this is how recurring blocks end.
  Associate + block id from URL. Set associate_block_id from POST data[n].id or GET Associate Blocks.
}
