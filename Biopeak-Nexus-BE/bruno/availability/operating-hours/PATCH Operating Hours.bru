meta {
  name: PATCH Operating Hours
  type: http
  seq: 1
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/availability/operating-hours/
  body: json
  auth: inherit
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

body:json {
  {
    "open_time": "09:00:00",
    "close_time": "18:00:00",
    "days": ["0", "1", "2", "3", "4", "5"],
    "closed_days": ["6"]
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Bulk upsert weekly hours. Open days share open_time/close_time; closed_days get is_open=false and null times.
  days / closed_days: string codes "0"=Mon … "6"=Sun.
  Rejects if active roster would fall outside the new window, or if closing a day that still has active roster (400 detail.day_errors; codes before_opening, after_closing, roster_on_closed_day). Inactive roster ignored.
}

example {
  name: 400 Roster exceeds new hours

  request: {
    url: {{baseURL}}/centers/{{center_id}}/availability/operating-hours/
    method: PATCH
    mode: json
    headers: {
      X-Center-ID: {{center_id}}
      content-type: application/json
    }

    body:json: {
      {
        "open_time": "10:00:00",
        "close_time": "16:00:00",
        "days": ["1"]
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "detail": {
            "non_field_errors": [
              "Operating hours conflict with existing staff roster."
            ],
            "day_errors": [
              {
                "day_of_week": "1",
                "day_of_week_name": "Tuesday",
                "open_time": "10:00:00",
                "close_time": "16:00:00",
                "errors": [
                  {
                    "code": "before_opening",
                    "field": "open_time",
                    "message": "Active roster starts before the new opening time.",
                    "associate_ids": ["0195a1b2-0000-7000-8000-000000000001"]
                  },
                  {
                    "code": "after_closing",
                    "field": "close_time",
                    "message": "Active roster ends after the new closing time.",
                    "associate_ids": ["0195a1b2-0000-7000-8000-000000000001"]
                  }
                ]
              }
            ]
          }
        }
      '''
    }
  }
}
