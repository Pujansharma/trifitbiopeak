meta {
  name: PATCH Service
  type: http
  seq: 2
}

patch {
  url: {{baseURL}}/services/{{service_id}}/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "IR Sauna"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Update catalog service fields (name, centers, etc.). Rename clash → 400.
  Set env service_id (UUID).
  Care templates → care-templates / PATCH Service Care Template.
}
