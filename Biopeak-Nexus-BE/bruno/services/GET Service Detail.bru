            "created_at": "2026-10-14T08:00:00.000000+00:00",
            "updated_at": "2026-10-14T08:00:00.000000+00:00",
            "is_active": true,
            "is_locked": false,
            "created_by": null
          }
        }
      '''
    }
  }
}
