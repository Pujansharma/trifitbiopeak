meta {
  name: Login Phone Direct
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/auth/login-phone-direct/
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {"phone":"{{phone}}"}
}

script:post-response {
  const body = res.getBody() || {};
  const data = body.data || {};
  const access = data.access;
  const refresh = data.refresh;

  if (access) {
    bru.deleteVar('access_token');
    bru.setVar('access_token', access);
    bru.setCollectionVar('access_token', access);
    bru.setCollectionVar('customer_access_token', access);
    if (bru.getEnvName()) {
      bru.setEnvVar('access_token', access);
      bru.setEnvVar('customer_access_token', access);
    }
  }
  if (refresh) {
    bru.deleteVar('refresh_token');
    bru.setVar('refresh_token', refresh);
    bru.setCollectionVar('refresh_token', refresh);
    if (bru.getEnvName()) {
      bru.setEnvVar('refresh_token', refresh);
    }
  }

  pm.test('Stores tokens when present', function () {
    pm.expect(access, 'data.access missing — login failed or unexpected envelope').to.be.ok;
  });
}

settings {
  encodeUrl: true
}

docs {
  Phone-only login without OTP. Looks up existing active User by phone. Create lead via leads/v2 first. Post-response stores JWT on env + collection as access_token.
}
