meta {
  name: POST No Show
  type: http
  seq: 6
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/{{appointment_id}}/no-show/
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Only allowed from confirmed status.
  When linked to a therapy program_service: RedemptionHistory scheduled→cancelled.
  sessions_used unchanged (same as cancel).
}
