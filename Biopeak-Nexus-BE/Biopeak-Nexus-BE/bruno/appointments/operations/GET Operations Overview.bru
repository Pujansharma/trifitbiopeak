meta {
  name: GET Operations Overview
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/appointments/operations/overview/?start=2026-09-01&granularity=week
  body: none
  auth: inherit
}

params:query {
  start: 2026-09-01
  granularity: week
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Cached operations overview for the center date range.
}
