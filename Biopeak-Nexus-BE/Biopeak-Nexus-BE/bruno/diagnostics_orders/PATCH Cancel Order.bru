meta {
  name: PATCH Cancel Order
  type: http
  seq: 8
}

patch {
  url: {{baseURL}}/diagnostics_orders/order/cancel/{{diagnostics_request_id}}/
  body: json
  auth: inherit
}

headers {
  @description('Optional')
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

body:json {
  {
    "reason": "customer_request",
    "explanation": "Customer cancelled"
  }
}

settings {
  encodeUrl: true
}

docs {
  Cancel via Orange Labs. Body: reason, explanation. Sets status order.cancelled.
}

example {
  name: 200 Cancelled
  
  request: {
    url: {{baseURL}}/diagnostics_orders/order/cancel/{{diagnostics_request_id}}/
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      X-Center-ID: {{center_id}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "reason": "customer_request",
        "explanation": "Customer cancelled"
      }
    }
  }
  
  response: {
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "detail": "Order cancelled.",
          "data": {
            "status": "order.cancelled"
          }
        }
      '''
    }
  }
}
