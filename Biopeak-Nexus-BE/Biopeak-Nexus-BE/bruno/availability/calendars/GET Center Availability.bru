meta {
  name: GET Center Availability
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/availability/?start=2026-09-01&granularity=week
  body: none
  auth: none
}

params:query {
  start: 2026-09-01
  granularity: week
}

headers {
  X-Center-ID: {{center_id}}
}

script:pre-request {
  const token =
    bru.getEnvVar('access_token') ||
    bru.getCollectionVar('access_token') ||
    bru.getVar('access_token') ||
    '';
  if (!token) {
    throw new Error('access_token missing — run Auth → Login Phone Direct (Development env)');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Center weekly operating hours + closures in range. Defaults granularity=week when omitted.
  Sample start=2026-09-01 → Mon–Sun week (aligned with POST Closure 2026-09-07).
  Omit start → today. Each day includes day_of_week ("0"=Mon … "6"=Sun) and day_of_week_name.
  Auth: pre-request sets Authorization from env/collection access_token (auth none — avoids empty Bearer). Run Login Phone Direct first.
}
